{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "pnpm build:vercel",
    "installCommand": "pnpm install",
    "functions": {
        "api/index.mjs": {
            "maxDuration": 10,
            "includeFiles": "dist/**"
        }
    },
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/assets/(.*)",
            "destination": "/dist/client/assets/$1"
        },
        {
            "source": "/favicon.svg",
            "destination": "/dist/client/favicon.svg"
        },
        {
            "source": "/icons.svg",
            "destination": "/dist/client/icons.svg"
        },
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ]
}