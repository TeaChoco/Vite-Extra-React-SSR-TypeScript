{
  "name": "vite-extra-react-ssr-ts",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc -b && pnpm run build:client && pnpm run build:server",
    "build:ssg": "pnpm build && nodemon scripts/prerender.mjs",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "cross-env VITE_MODE=production VITE_CLIENT_BASE=/TeaChoco/ tsx server.ts",
    "serve": "cross-env VITE_MODE=production VITE_CLIENT_BASE=/TeaChoco/ tsx server.ts",
    "lint": "eslint .",
    "prerender": "tsx prerender.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.0",
    "@textea/json-viewer": "^4.0.1",
    "axios": "^1.15.2",
    "chalk": "^5.6.2",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.2",
    "sirv": "^3.0.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.22.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.10"
  }
}